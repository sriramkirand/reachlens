{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"],
    "paths": { "@/*": ["./src/web/*"], "@shared/*": ["./src/shared/*"] }
  },
  "include": ["src", "test", "worker-configuration.d.ts"]
}
